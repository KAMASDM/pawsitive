{
  "name": "sweekar",
  "homepage": "./",
  "version": "0.1.1",
  "private": true,
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@react-google-maps/api": "^2.19.3",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/typography": "^0.5.15",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "browser-image-compression": "^2.0.2",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "emoji-picker-react": "^4.12.2",
    "firebase": "^12.6.0",
    "framer-motion": "^12.6.5",
    "geofire-common": "^6.0.0",
    "html2canvas": "^1.4.1",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.453.0",
    "node-fetch": "^2.7.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0",
    "react-router-dom": "^6.26.2",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "dev": "vite",
    "dev:netlify": "netlify dev",
    "prebuild": "node scripts/generate-firebase-sw.js",
    "build": "vite build && node scripts/retain-deploy-assets.cjs && npm run generate-sitemap",
    "generate-sitemap": "node generate-sitemap.js",
    "preview": "vite preview",
    "deploy": "netlify deploy --prod",
    "test-email-function": "node netlify/functions/test-daily-reminders.js",
    "test": "node --test functions/test/*.test.js",
    "report:retention": "node scripts/report-retention.cjs",
    "test:rules": "firebase emulators:exec --project demo-pawppy --only database --config firebase.emulators.json \"node --test --test-concurrency=1 tests/databaseRules.emulator.cjs tests/scheduledReminders.emulator.cjs tests/familyApi.emulator.cjs tests/copilotApi.emulator.cjs\"",
    "test:browser": "firebase emulators:exec --project demo-pawppy --only database,auth --config firebase.emulators.json \"playwright test\""
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "sitemap": "^8.0.0",
    "tailwindcss": "^3.4.14",
    "vite": "^7.2.2",
    "vite-plugin-pwa": "^1.2.0"
  },
  "overrides": {
    "serialize-javascript": "^7.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "http-proxy-agent": "^7.0.2"
  }
}
