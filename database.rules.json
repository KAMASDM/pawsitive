{
  "rules": {
    "users": {
      "$userId": {
        ".read": "auth != null && auth.uid == $userId",
        ".write": "auth != null && auth.uid == $userId"
      }
    },
    "petSlugs": {
      "$slug": {
        ".read": "data.exists() && ((auth != null && data.child('userId').val() == auth.uid) || root.child('userPets').child(data.child('userId').val()).child(data.child('petId').val()).child('privacy/isPrivate').val() != true)",
        ".write": "auth != null && ((!data.exists() && newData.child('userId').val() == auth.uid) || data.child('userId').val() == auth.uid) && (!newData.exists() || (newData.child('userId').val() == auth.uid && root.child('petOwners').child(newData.child('petId').val()).val() == auth.uid))"
      }
    },
    "userPets": {
      "$userId": {
        ".read": "auth != null && auth.uid == $userId",
        "$petId": {
          ".write": "auth != null && auth.uid == $userId && newData.parent().parent().parent().child('petOwners').child($petId).val() == auth.uid"
        }
      }
    },
    "petPosts": {
      "$petId": {
        ".read": "auth != null && root.child('petOwners').child($petId).val() == auth.uid",
        ".write": "auth != null && root.child('petOwners').child($petId).val() == auth.uid && root.child('userPets').child(auth.uid).child($petId).exists()",
        "$postId": {
          ".validate": "newData.hasChildren(['mediaUrl', 'mediaType', 'timestamp'])"
        },
        ".indexOn": [
          "timestamp"
        ]
      }
    },
    "petEvents": {
      "$petId": {
        ".read": "auth != null && root.child('petOwners').child($petId).val() == auth.uid",
        ".write": "auth != null && root.child('petOwners').child($petId).val() == auth.uid && root.child('userPets').child(auth.uid).child($petId).exists()",
        "$eventId": {
          ".validate": "newData.hasChildren(['title', 'date', 'type', 'timestamp'])"
        },
        ".indexOn": [
          "timestamp"
        ]
      }
    },
    "petProfiles": {
      "$petId": {
        ".read": "auth != null && root.child('petOwners').child($petId).val() == auth.uid",
        ".write": "auth != null && root.child('petOwners').child($petId).val() == auth.uid && root.child('userPets').child(auth.uid).child($petId).exists()"
      }
    },
    "matingRequests": {
      "sent": {
        "$userId": {
          ".read": "auth != null && auth.uid == $userId",
          ".write": "auth != null && auth.uid == $userId"
        }
      },
      "received": {
        "$userId": {
          ".read": "auth != null && auth.uid == $userId",
          ".write": "auth != null && auth.uid == $userId"
        }
      }
    },
    "adoptionRequests": {
      "$requestId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "userResources": {
      "$userId": {
        ".read": "auth != null && auth.uid == $userId",
        ".write": "auth != null && auth.uid == $userId"
      }
    },
    "conversations": {
      "$conversationId": {
        ".read": "auth != null && (!data.exists() || data.child('participants').child(auth.uid).val() == true)",
        ".write": "auth != null && !data.exists() && newData.child('participants').child(auth.uid).val() == true",
        ".validate": "newData.hasChild('participants')",
        "participants": {
          "$uid": {
            ".validate": "newData.val() == true && (!data.parent().exists() || data.exists())"
          },
          ".write": false
        },
        "messages": {
          "$id": {
            ".validate": "newData.hasChildren(['senderId','text','timestamp']) && ((!data.exists() && newData.child('senderId').val() == auth.uid) || (data.exists() && newData.child('senderId').val() == data.child('senderId').val() && newData.child('text').val() == data.child('text').val() && newData.child('timestamp').val() == data.child('timestamp').val()))",
            "text": {
              ".validate": "newData.isString() && newData.val().length <= 10000"
            },
            "timestamp": {
              ".validate": "newData.isNumber()"
            },
            ".write": "auth != null && root.child('conversations').child($conversationId).child('participants').child(auth.uid).val() == true"
          }
        },
        "typing": {
          "$uid": {
            ".validate": "auth.uid == $uid",
            ".write": "auth != null && root.child('conversations').child($conversationId).child('participants').child(auth.uid).val() == true && auth.uid == $uid"
          }
        },
        "$other": {
          ".write": "auth != null && root.child('conversations').child($conversationId).child('participants').child(auth.uid).val() == true"
        }
      }
    },
    "resources": {
      "$placeId": {
        "comments": {
          ".read": "true",
          ".write": "auth != null"
        }
      }
    },
    "userComments": {
      "$userId": {
        ".read": "auth != null && auth.uid == $userId",
        ".write": "auth != null && auth.uid == $userId"
      }
    },
    "comments": {
      "$resourceId": {
        ".read": "true",
        ".write": "auth != null"
      }
    },
    "taggedPlaces": {
      ".read": "true",
      ".write": "auth != null",
      "$placeId": {
        ".validate": "newData.hasChildren(['placeName', 'location', 'geohash', 'isPetFriendly', 'comment', 'userId', 'userEmail', 'timestamp', 'createdAt'])"
      }
    },
    "notifications": {
      "$userId": {
        ".read": "auth != null && auth.uid == $userId",
        ".write": "auth != null"
      }
    },
    "broadcastNotifications": {
      ".read": "auth != null",
      ".write": "false"
    },
    "notificationReads": {
      "$userId": {
        ".read": "auth != null && auth.uid == $userId",
        ".write": "auth != null && auth.uid == $userId"
      }
    },
    "vendorApplications": {
      ".read": "auth != null && auth.token.email == 'anantsoftcomputing@gmail.com'",
      "$userId": {
        ".read": "auth != null && auth.uid == $userId",
        ".write": "auth != null && (auth.token.email == 'anantsoftcomputing@gmail.com' || (auth.uid == $userId && (!newData.child('status').exists() || newData.child('status').val() == 'pending')))"
      }
    },
    "vendorApprovals": {
      ".read": "auth != null && auth.token.email == 'anantsoftcomputing@gmail.com'",
      "$userId": {
        ".read": "auth != null && auth.uid == $userId",
        ".write": "auth != null && auth.token.email == 'anantsoftcomputing@gmail.com'"
      }
    },
    "vendorDocuments": {
      "$vendorId": {
        ".read": "auth != null && (auth.token.role == 'admin' || auth.token.vendorId == $vendorId)",
        "$documentType": {
          ".write": "auth != null && (auth.token.role == 'admin' || auth.token.vendorId == $vendorId)"
        }
      }
    },
    "vendorStores": {
      ".read": "true",
      "$storeId": {
        ".write": "auth != null && root.child('vendorApprovals').child(auth.uid).child('approved').val() == true && (!data.exists() || data.child('ownerId').val() == auth.uid || newData.child('ownerId').val() == auth.uid)"
      }
    },
    "vendorStoreSlugs": {
      ".read": "true",
      "$slug": {
        ".write": "auth != null && root.child('vendorApprovals').child(auth.uid).child('approved').val() == true && (!data.exists() || data.child('ownerId').val() == auth.uid)"
      }
    },
    "vendorProducts": {
      ".read": "true",
      "$storeId": {
        "$productId": {
          ".write": "auth != null && root.child('vendorStores').child($storeId).child('ownerId').val() == auth.uid"
        }
      }
    },
    "buyerOrders": {
      "$userId": {
        ".read": "auth != null && auth.uid == $userId",
        ".write": "auth != null && auth.uid == $userId"
      }
    },
    "vendorOrders": {
      "$storeId": {
        ".read": "auth != null && root.child('vendorStores').child($storeId).child('ownerId').val() == auth.uid",
        "$orderId": {
          ".write": "auth != null && (root.child('vendorStores').child($storeId).child('ownerId').val() == auth.uid || newData.child('buyerId').val() == auth.uid)"
        }
      }
    },
    "lostPets": {
      ".read": "true",
      "$reportId": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['petType', 'petName', 'lastSeenDate', 'lastSeenLocation', 'userId', 'status', 'createdAt'])"
      }
    },
    "foundPets": {
      ".read": "true",
      "$reportId": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['petType', 'foundDate', 'foundLocation', 'userId', 'status', 'createdAt'])"
      }
    },
    "notificationDevices": {
      "$userId": {
        ".read": "auth != null && auth.uid == $userId",
        ".write": false
      }
    },
    "notificationInstallations": {
      ".read": false,
      ".write": false
    },
    "notificationDeliveries": {
      ".read": false,
      ".write": false
    },
    "productEvents": {
      "$userId": {
        ".read": false,
        ".indexOn": [
          "timestamp"
        ],
        "$eventId": {
          ".write": "auth != null && auth.uid == $userId && !data.exists() && newData.exists() && root.child('users').child($userId).child('productMeasurementEnabled').val() != false",
          ".validate": "newData.hasChildren(['name', 'screen', 'sessionId', 'timestamp', 'platform'])",
          "name": {
            ".validate": "newData.isString() && newData.val().matches(/^(session_started|signup_completed|pet_created|health_record_saved|medication_saved|notification_setup_succeeded|notification_setup_failed|notification_opened|preferences_saved|routine_created|routine_completed|routine_corrected)$/)"
          },
          "screen": {
            ".validate": "newData.isString() && newData.val().matches(/^(login|home|pets|care|notifications|settings|discover|shop|activity|other)$/)"
          },
          "sessionId": {
            ".validate": "newData.isString() && newData.val().matches(/^[a-zA-Z0-9_-]{8,100}$/)"
          },
          "timestamp": {
            ".validate": "newData.isNumber() && newData.val() <= now && newData.val() >= now - 60000"
          },
          "platform": {
            ".validate": "newData.val() == 'browser' || newData.val() == 'installed'"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "petOwners": {
      "$petId": {
        ".read": "auth != null && data.val() == auth.uid",
        ".write": "auth != null && (!data.exists() || data.val() == auth.uid) && newData.val() == auth.uid",
        ".validate": "newData.isString()"
      }
    },
    "careRoutines": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || (root.child('careFamilies').child($uid).child('members').child(auth.uid).child('expiresAt').val() > now && root.child('careFamilies').child($uid).child('members').child(auth.uid).child('role').val().matches(/^(caregiver|viewer|sitter)$/)))",
        "$id": {
          ".write": "auth != null && auth.uid == $uid && newData.exists() && root.child('userPets').child($uid).child(newData.child('petId').val()).exists()",
          ".validate": "newData.hasChildren(['petId', 'title', 'kind', 'time', 'startDate', 'active', 'createdAt'])",
          "petId": {
            ".validate": "newData.isString() && (!data.exists() || newData.val() == data.val())"
          },
          "title": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80 && (!data.exists() || newData.val() == data.val())"
          },
          "kind": {
            ".validate": "newData.isString() && newData.val().matches(/^(meal|water|walk|play|grooming|litter|other)$/) && (!data.exists() || newData.val() == data.val())"
          },
          "time": {
            ".validate": "newData.isString() && newData.val().matches(/^([01][0-9]|2[0-3]):[0-5][0-9]$/) && (!data.exists() || newData.val() == data.val())"
          },
          "startDate": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && (!data.exists() || newData.val() == data.val())"
          },
          "active": {
            ".validate": "newData.isBoolean()"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && ((!data.exists() && newData.val() <= now && newData.val() >= now - 60000) || newData.val() == data.val())"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "careDays": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || (root.child('careFamilies').child($uid).child('members').child(auth.uid).child('expiresAt').val() > now && root.child('careFamilies').child($uid).child('members').child(auth.uid).child('role').val().matches(/^(caregiver|viewer|sitter)$/)))",
        "$day": {
          ".validate": "$day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
          "$id": {
            ".write": "auth != null && (auth.uid == $uid || (root.child('careFamilies').child($uid).child('members').child(auth.uid).child('expiresAt').val() > now && root.child('careFamilies').child($uid).child('members').child(auth.uid).child('role').val().matches(/^(caregiver|sitter)$/))) && newData.exists() && root.child('careRoutines').child($uid).child($id).exists() && root.child('userPets').child($uid).child(newData.child('petId').val()).exists()",
            ".validate": "newData.hasChildren(['petId', 'title', 'status', 'updatedBy', 'updatedAt', 'revision']) && (!data.exists() || newData.child('status').val() != data.child('status').val())",
            "petId": {
              ".validate": "newData.val() == root.child('careRoutines').child($uid).child($id).child('petId').val()"
            },
            "title": {
              ".validate": "newData.val() == root.child('careRoutines').child($uid).child($id).child('title').val()"
            },
            "status": {
              ".validate": "newData.val() == 'open' || (newData.val() == 'done' && root.child('careRoutines').child($uid).child($id).child('active').val() == true)"
            },
            "updatedBy": {
              ".validate": "newData.val() == auth.uid"
            },
            "updatedAt": {
              ".validate": "newData.isNumber() && newData.val() <= now && newData.val() >= now - 60000"
            },
            "revision": {
              ".validate": "newData.isNumber() && ((!data.exists() && newData.val() == 1) || (data.exists() && newData.val() == data.val() + 1))"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "careFamilies": {
      ".read": false,
      ".write": false
    },
    "careAccess": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": false
      }
    },
    "copilotConfig": {
      ".read": false,
      ".write": false
    },
    "copilotUsage": {
      ".read": false,
      ".write": false
    }
  }
}
